#!/bin/sh
# Restore drill: proves the pgBackRest repo can rebuild the shared Postgres up to the
# last archived WAL. Writes a marker row after the latest base backup, restores into a
# scratch container (archiving off, so it never writes to the repo), checks the marker
# and every app table's row count against live, then removes the scratch.
# Run on t4a as root: sh /srv/postgres/restore-drill. Read-only for the live database
# apart from the marker table `restore_drill` in the `postgres` database.
set -eu
cd /srv/postgres
IMAGE=$(docker inspect -f '{{.Config.Image}}' postgres-postgres-1)
psql_live() { docker compose exec -T postgres psql -U postgres -At "$@" </dev/null; }

marker=$(date -u +%Y%m%dT%H%M%SZ)
psql_live -c "CREATE TABLE IF NOT EXISTS restore_drill (marker text PRIMARY KEY, at timestamptz DEFAULT now())" >/dev/null
psql_live -c "INSERT INTO restore_drill (marker) VALUES ('$marker')" >/dev/null
psql_live -c "SELECT pg_switch_wal()" >/dev/null
# Wait until the segment holding the marker is in the repo.
docker compose exec -T -u postgres postgres pgbackrest --stanza=main check </dev/null >/dev/null

docker rm -f pgdrill >/dev/null 2>&1 || true
docker volume rm pgdrill_data >/dev/null 2>&1 || true
trap 'docker rm -f pgdrill >/dev/null 2>&1; docker volume rm pgdrill_data >/dev/null 2>&1' EXIT
mounts="-v pgdrill_data:/var/lib/postgresql -v /srv/postgres/postgresql.conf:/etc/postgresql/postgresql.conf:ro -v /srv/postgres/pgbackrest.conf:/etc/pgbackrest/pgbackrest.conf:ro -v /srv/postgres/pgbackrest-ssh:/etc/pgbackrest/ssh:ro"

docker run --rm $mounts --entrypoint sh "$IMAGE" -c 'mkdir -p /var/lib/postgresql/18/docker /var/lib/postgresql/pgbackrest/log /var/lib/postgresql/pgbackrest/spool && chown -R postgres:postgres /var/lib/postgresql && chmod 700 /var/lib/postgresql/18/docker'
docker run --rm -u postgres --env-file .env $mounts "$IMAGE" \
  pgbackrest --stanza=main --log-level-console=warn restore </dev/null
docker run -d --name pgdrill --env-file .env $mounts --shm-size 256m "$IMAGE" \
  postgres -c config_file=/etc/postgresql/postgresql.conf -c archive_mode=off -c shared_buffers=128MB >/dev/null

for i in $(seq 1 90); do
  docker exec pgdrill psql -U postgres -Atc "SELECT NOT pg_is_in_recovery()" 2>/dev/null | grep -q t && break
  sleep 2
done
found=$(docker exec pgdrill psql -U postgres -Atc "SELECT count(*) FROM restore_drill WHERE marker = '$marker'")
[ "$found" = 1 ] || { echo "FAIL: marker $marker not in the restored database"; exit 1; }
echo "marker $marker restored"

# Every table in every app database, row counts live vs restored.
rc=0
for db in $(psql_live -c "SELECT datname FROM pg_database WHERE NOT datistemplate AND datname <> 'postgres'"); do
  q="SELECT string_agg(format('SELECT %L, count(*) FROM %I.%I', schemaname||'.'||relname, schemaname, relname), ' UNION ALL ') FROM pg_stat_user_tables"
  sql=$(psql_live -d "$db" -c "$q")
  [ -n "$sql" ] || continue
  live=$(psql_live -d "$db" -c "$sql" | sort)
  restored=$(docker exec pgdrill psql -U postgres -At -d "$db" -c "$sql" | sort)
  if [ "$live" = "$restored" ]; then echo "$db: $(echo "$live" | wc -l) tables match"; else echo "$db: row counts differ (writes since the marker?)"; rc=1; fi
done
exit $rc
