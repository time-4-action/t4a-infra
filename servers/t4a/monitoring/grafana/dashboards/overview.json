  {
   "type": "table",
   "title": "Every site and API",
   "id": 4,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "probe_success",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "probe_duration_seconds",
     "legendFormat": "",
     "refId": "B",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "probe_http_status_code",
     "legendFormat": "",
     "refId": "C",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "avg_over_time(probe_success[24h])",
     "legendFormat": "",
     "refId": "D",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "gridPos": {
    "h": 12,
    "w": 20,
    "x": 4,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Status"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "0": {
            "text": "DOWN",
            "color": "red"
           },
           "1": {
            "text": "UP",
            "color": "green"
           }
          }
         }
        ]
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Response"
      },
      "properties": [
       {
        "id": "unit",
        "value": "s"
       },
       {
        "id": "decimals",
        "value": 2
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "green",
           "value": null
          },
          {
           "color": "orange",
           "value": 2
          },
          {
           "color": "red",
           "value": 5
          }
         ]
        }
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Up 24 h"
      },
      "properties": [
       {
        "id": "unit",
        "value": "percentunit"
       },
       {
        "id": "decimals",
        "value": 2
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "red",
           "value": null
          },
          {
           "color": "orange",
           "value": 0.99
          },
          {
           "color": "green",
           "value": 0.999
          }
         ]
        }
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "URL"
      },
      "properties": [
       {
        "id": "links",
        "value": [
         {
          "title": "Open",
          "url": "${__value.raw}",
          "targetBlank": true
         }
        ]
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   },
   "transformations": [
    {
     "id": "joinByField",
     "options": {
      "byField": "instance",
      "mode": "outer"
     }
    },
    {
     "id": "organize",
     "options": {
      "includeByName": {
       "name": true,
       "group": true,
       "host": true,
       "instance": true,
       "Value #A": true,
       "Value #B": true,
       "Value #C": true,
       "Value #D": true
      },
      "renameByName": {
       "name": "Name",
       "group": "Group",
       "host": "Runs on",
       "instance": "URL",
       "Value #A": "Status",
       "Value #B": "Response",
       "Value #C": "HTTP",
       "Value #D": "Up 24 h"
      },
      "indexByName": {
       "name": 0,
       "Value #A": 1,
       "Value #B": 2,
       "Value #C": 3,
       "Value #D": 4,
       "group": 5,
       "host": 6,
       "instance": 7
      }
     }
    },
    {
     "id": "sortBy",
     "options": {
      "sort": [
       {
        "field": "Status"
       }
      ]
     }
    }
   ]
