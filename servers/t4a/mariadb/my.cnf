# MariaDB server settings for t4a (README.md). Sized for a handful of WordPress sites on a
# box that also runs Postgres and the apps.
[mysqld]
character-set-server = utf8mb4
# No collation-server: a non-default one breaks `mariadb-dump --system=users` (the backup).
# new-site.sh sets utf8mb4_unicode_ci on each site's database instead.
skip-name-resolve

innodb_buffer_pool_size = 256M
max_connections = 60
max_allowed_packet = 64M
# Saves about 100 MB of RAM; nothing here reads it.
performance_schema = OFF

slow_query_log = 1
slow_query_log_file = /var/lib/mysql/slow.log
long_query_time = 1
