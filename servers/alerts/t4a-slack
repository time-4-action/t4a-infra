#!/bin/sh
# Post one message to the #t4a-server Slack channel: t4a-slack "text" (Slack mrkdwn).
# Installed as /usr/local/bin/t4a-slack on both servers. The webhook URL is in
# /etc/t4a-slack.env (SLACK_WEBHOOK_URL=..., mode 600); without it the text goes to stderr.
set -eu
[ -f /etc/t4a-slack.env ] && . /etc/t4a-slack.env
if [ -z "${SLACK_WEBHOOK_URL:-}" ]; then echo "t4a-slack (no webhook): $1" >&2; exit 0; fi
python3 -c 'import json, sys; print(json.dumps({"text": sys.argv[1]}))' "$1" |
  curl -fsS -m 15 --retry 3 -H 'Content-Type: application/json' --data-binary @- "$SLACK_WEBHOOK_URL" >/dev/null
