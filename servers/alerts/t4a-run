#!/bin/sh
# Cron wrapper: t4a-run <name> <command...> appends the command's output to
# /var/log/<name>.log and posts its last lines to Slack if it fails.
# The exit code and time of the last run go to /var/lib/t4a-run/<name>; t4a-daily lists the failed ones.
# Installed as /usr/local/bin/t4a-run on both servers.
name=$1; shift
log=/var/log/$name.log
"$@" >> "$log" 2>&1
rc=$?
mkdir -p /var/lib/t4a-run && echo "$rc $(date +%s)" > "/var/lib/t4a-run/$name"
if [ "$rc" != 0 ]; then
  /usr/local/bin/t4a-slack ":red_circle: *$(hostname -s)*: \`$name\` failed (exit $rc)
\`\`\`$(tail -n 15 "$log")\`\`\`"
fi
exit "$rc"
