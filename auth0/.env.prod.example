# PROD tenant — Auth0 deploy-cli settings.
# Copy to .env.prod, fill values, then encrypt:
#   npx dotenvx encrypt -f auth0/.env.prod
# After encrypting, auth0/.env.prod is safe to commit (values are ciphertext).
# NEVER commit auth0/.env.keys (the decryption keys).

AUTH0_DOMAIN="<fill-me>.auth0.com"
AUTH0_CLIENT_ID="<fill-me>"
AUTH0_CLIENT_SECRET="<fill-me>"

# Safety: never let an import delete prod state.
AUTH0_ALLOW_DELETE="false"
