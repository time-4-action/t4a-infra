# DEV tenant — Auth0 deploy-cli settings.
# Copy to .env.dev, fill values, then encrypt:
#   npx dotenvx encrypt -f auth0/.env.dev
# After encrypting, auth0/.env.dev is safe to commit (values are ciphertext).
# NEVER commit auth0/.env.keys (the decryption keys).

AUTH0_DOMAIN="<fill-me>.auth0.com"
AUTH0_CLIENT_ID="<fill-me>"
AUTH0_CLIENT_SECRET="<fill-me>"

# dev is a scratch copy — allow imports to converge it fully.
AUTH0_ALLOW_DELETE="true"

# Substituted into ##KEYWORD## placeholders in tenant.yaml on import,
# so dev points at dev URLs/audiences instead of prod. JSON string.
AUTH0_KEYWORD_REPLACE_MAPPINGS={"PORTAL_URL":"<fill-me>","API_IDENTIFIER":"<fill-me>"}
