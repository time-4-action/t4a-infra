#!/bin/sh
# pre-commit hook — refuses any commit that contains a plaintext .env file
# that is supposed to be encrypted with dotenvx.
#
# Armed by: git config core.hooksPath .githooks  (run once per clone;
# `npm run prepare` / `npm install` does this for you).
#
# To bypass in a genuine emergency: git commit --no-verify  (don't, unless you
# are SURE the file is safe).

hook_dir="$(dirname "$0")"
node "$hook_dir/check-env-encrypted.mjs" --staged
