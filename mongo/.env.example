# MongoDB sync — connection strings for prod and dev.
# Copy to .env, fill values, then encrypt:
#   npx dotenvx encrypt -f mongo/.env
# After encrypting, mongo/.env is safe to commit (values are ciphertext).
# NEVER commit mongo/.env.keys (the decryption keys).

# Full mongosh / MongoDB connection URIs (SRV or standard).
# Include the database name in the path if you want to scope the copy,
# e.g. mongodb+srv://user:pass@cluster.mongodb.net/t4a
PROD_MONGOSH="mongodb+srv://<user>:<pass>@<prod-host>/<db>"
DEV_MONGOSH="mongodb+srv://<user>:<pass>@<dev-host>/<db>"
